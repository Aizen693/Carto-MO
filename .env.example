# ──────────────────────────────────────────────────────────────────────────────
# Inoreader Dashboard — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs.
# Ne commitez JAMAIS le fichier .env.
# ──────────────────────────────────────────────────────────────────────────────

# Credentials de l'application Inoreader
# Créez votre app sur : https://www.inoreader.com/developers/
# Renseignez l'URL de redirection : http://localhost:8080
INOREADER_APP_ID=1234567890
INOREADER_APP_KEY=your_app_key_here

# OAuth 2.0 — Client credentials (disponibles sur la page de votre app)
INOREADER_CLIENT_ID=your_client_id_here
INOREADER_CLIENT_SECRET=your_client_secret_here

# Tokens OAuth 2.0
# Obtenez-les en lançant : python oauth_setup.py
# L'access_token expire (typiquement 1h) ; il sera rafraîchi automatiquement
# via le refresh_token. Mettez à jour INOREADER_REFRESH_TOKEN si l'app en
# retourne un nouveau (rotation de tokens).
INOREADER_ACCESS_TOKEN=ya29.your_access_token_here
INOREADER_REFRESH_TOKEN=your_refresh_token_here
