# ──────────────────────────────────────────────────────────────────────────────
# Inoreader Dashboard — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs.
# Ne commitez JAMAIS le fichier .env.
# ──────────────────────────────────────────────────────────────────────────────

# Credentials de l'application Inoreader
# Créez votre app sur : https://www.inoreader.com/developers/
# Renseignez l'URL de redirection : http://localhost:8080
INOREADER_APP_ID=1234567890
INOREADER_APP_KEY=your_app_key_here

# OAuth 2.0 — Client credentials (disponibles sur la page de votre app)
INOREADER_CLIENT_ID=your_client_id_here
INOREADER_CLIENT_SECRET=your_client_secret_here

# Tokens OAuth 2.0 — servent uniquement d'AMORÇAGE.
# Obtenez-les en lançant : python oauth_setup.py
# L'access_token expire (~1h) ; il est rafraîchi automatiquement via le
# refresh_token. Inoreader fait tourner (rotation) le refresh_token : le
# nouveau est désormais persisté dans Supabase (voir ci-dessous), donc plus
# besoin de mettre à jour INOREADER_REFRESH_TOKEN à la main.
INOREADER_ACCESS_TOKEN=ya29.your_access_token_here
INOREADER_REFRESH_TOKEN=your_refresh_token_here

# ──────────────────────────────────────────────────────────────────────────────
# Coffre durable des jetons (Supabase)
# Permet au refresh_token roté de survivre aux redémarrages de Streamlit Cloud.
# SUPABASE_URL a une valeur par défaut dans le code : seul SUPABASE_SERVICE_KEY
# est requis. Clé "service_role" : Supabase → Project Settings → API.
# À mettre dans les secrets Streamlit Cloud — ne JAMAIS la commiter.
# ──────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://lwgrjdpuagnvvzmdbyzb.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
