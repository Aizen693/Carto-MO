# Copie ce fichier en n8n/.env et colle tes VRAIES cles (n8n/.env est gitignore).
# Regenere tes cles si elles ont deja fuite (screenshot, historique...).

MISTRAL_API_KEY=""
BRAVE_API_KEY=""

# Google grounding en secours: laisse false pour rester 100% Mistral + Brave (RGPD).
GOOGLE_API_KEY=""
USE_GOOGLE_FALLBACK="false"

# Seuil de corroboration (defaut 0.7)
CORROB_SEUIL="0.7"

# --- Service HTTP (serveur.mjs) ---
PORT="8090"
# 127.0.0.1 = accessible seulement depuis le VPS (recommande si l'agent tourne sur le VPS).
# 0.0.0.0 = accessible depuis l'exterieur (seulement si l'agent est ailleurs; garde un TOKEN fort).
VEILLE_HOST="127.0.0.1"
# Mot de passe de l'URL. Mets-en un, meme simple. Vide = ouvert.
VEILLE_TOKEN=""
