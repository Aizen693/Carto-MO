# Headers de securite servis par Cloudflare Pages pour tous les chemins.
# Doc Cloudflare : https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Content-Security-Policy : restreint d'ou peut etre chargee la page.
  # On garde 'unsafe-inline' pour scripts/styles car le code en utilise beaucoup ;
  # le benefice principal vient de connect-src/script-src qui bloquent l'exfil
  # vers un domaine inconnu et l'injection d'un <script src="evil.com">.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://api.mapbox.com https://cdn.sheetjs.com https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://api.mapbox.com https://fonts.googleapis.com https://unpkg.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://lwgrjdpuagnvvzmdbyzb.supabase.co wss://lwgrjdpuagnvvzmdbyzb.supabase.co https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com wss://stream.aisstream.io https://api.github.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'

  # Bloque l'embed du site dans une iframe externe (anti-clickjacking).
  X-Frame-Options: SAMEORIGIN

  # Empeche les navigateurs de "deviner" un type MIME (anti-XSS via fichier mal type).
  X-Content-Type-Options: nosniff

  # Limite le Referer envoye aux sites externes a l'origine seule.
  Referrer-Policy: strict-origin-when-cross-origin

  # Refuse l'acces aux API sensibles que le site n'utilise pas.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

  # Force HTTPS pour 2 ans + tous sous-domaines (Cloudflare le set deja, on confirme).
  Strict-Transport-Security: max-age=63072000; includeSubDomains
